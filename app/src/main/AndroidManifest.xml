<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries><package android:name="com.mockgeo.module" /></queries>

    <!-- 定位 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- 前台服务（target 36：location + specialUse 双类型） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 通知（33+） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 悬浮窗 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- sendExtraCommand（LSPosed 引擎控制面；普通权限） -->
    <uses-permission android:name="android.permission.ACCESS_LOCATION_EXTRA_COMMANDS" />
    <!-- osmdroid 瓦片 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".MockGeoApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@style/Theme.MockGeo"
        android:usesCleartextTraffic="false">
        <meta-data android:name="com.amap.api.v2.apikey" android:value="${AMAP_API_KEY}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 模拟前台服务：location + specialUse 双类型（docs/08 §10） -->
        <service
            android:name=".sim.SimulationService"
            android:exported="false"
            android:foregroundServiceType="location|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="location_simulation" />
        </service>

        <!-- 悬浮摇杆服务 -->
        <service
            android:name=".overlay.JoystickOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating_joystick" />
        </service>

        <!-- 控制面状态回执 provider（模块 system_server 写，本 App 读；uid 校验） -->
        <provider
            android:name=".status.StatusProvider"
            android:authorities="com.mockgeo.app.status"
            android:exported="true" />
    </application>
</manifest>
